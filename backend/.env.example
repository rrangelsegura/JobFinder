# Application
PORT=3000
NODE_ENV=development

# Prisma / PostgreSQL (matches infra/docker-compose.yml's `postgres` service)
DATABASE_URL="postgresql://jobfinder:jobfinder@localhost:5433/jobfinder?schema=public"

# Redis / BullMQ (matches infra/docker-compose.yml's `redis` service)
REDIS_HOST=localhost
REDIS_PORT=6379

# Python Agentic Core (matches infra/docker-compose.yml's `backend-agent` service)
AGENT_CORE_URL=http://localhost:8000
