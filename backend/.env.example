# Application
PORT=3000
NODE_ENV=development

# Prisma / PostgreSQL (matches infra/docker-compose.yml's `postgres` service)
DATABASE_URL="postgresql://jobfinder:jobfinder@localhost:5433/jobfinder?schema=public"

# Redis / BullMQ (matches infra/docker-compose.yml's `redis` service)
REDIS_HOST=localhost
REDIS_PORT=6379

# Python Agentic Core (matches infra/docker-compose.yml's `backend-agent` service)
AGENT_CORE_URL=http://localhost:8000

# Frontend (needed to build links in emails, e.g. the email-verification link)
FRONTEND_URL=http://localhost:5173

# Email — defaults to MailDev (matches infra/docker-compose.yml's `maildev`
# service; view sent mail at http://localhost:1080). MailDev takes no auth,
# so leave SMTP_USER/SMTP_PASSWORD unset locally.
#
# To use a real provider (e.g. Resend's SMTP relay) in a deployed
# environment, override these instead:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASSWORD=<your Resend API key>
# Until a custom domain is verified in Resend, its shared sandbox sender only
# delivers to the Resend account owner's own address — see
# candidate-email-verification's design.md.
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="JobFinder <no-reply@jobfinder.dev>"
