// JobFinder relational schema — candidate domain only.
// Source of truth: docs/data-model.md §2.1 (Core Candidate Entities).
// Recruitment/company entities (Company, Employee, Position, Application, Interview, ...)
// are intentionally not modeled here — they belong to a different feature/change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillType {
  technical
  soft
}

model Candidate {
  id           Int     @id @default(autoincrement())
  firstName    String  @db.VarChar(100)
  lastName     String  @db.VarChar(100)
  email        String  @unique @db.VarChar(255)
  phone        String? @db.VarChar(15)
  address      String? @db.VarChar(100)
  passwordHash String  @db.VarChar(255)

  // candidate-email-verification: null until the candidate proves they own
  // this address by clicking the link in the verification email. requireAuth
  // gates every protected route on this being set, not just on having a
  // valid session — this is the first timestamp field Candidate has.
  emailVerifiedAt DateTime?

  educations      Education[]
  workExperiences WorkExperience[]
  resumes         Resume[]
  skills          Skill[]
  languages       Language[]
  certifications  Certification[]

  @@map("candidates")
}

model Education {
  id          Int       @id @default(autoincrement())
  institution String    @db.VarChar(100)
  title       String    @db.VarChar(250)
  // cv-extraction-schema-gaps: a real CV stated no start date for one
  // education entry (only a graduation year) — nullable rather than
  // fabricating a value.
  startDate   DateTime?
  endDate     DateTime?

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@map("educations")
}

model WorkExperience {
  id          Int       @id @default(autoincrement())
  company     String    @db.VarChar(100)
  position    String    @db.VarChar(100)
  // cv-upload-hardening: VarChar(200) (parse-candidate-cv's original limit)
  // was sized for synthetic fixtures, not real job descriptions — a real CV
  // exceeded it and crashed the persistence transaction. Unbounded (maps to
  // Postgres TEXT) instead of guessing a "big enough" fixed length.
  description String?
  // work-experience-date-gaps: a real CV stated no start date for several
  // jobs — nullable rather than fabricating a value (mirrors Education).
  startDate   DateTime?
  endDate     DateTime?

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  responsibilities WorkExperienceResponsibility[]
  projects         Project[]

  @@map("work_experiences")
}

// work-experience-detail: role-level duties, distinct from a specific
// Project's own achievements/stack below.
model WorkExperienceResponsibility {
  id   Int    @id @default(autoincrement())
  text String

  workExperienceId Int
  workExperience   WorkExperience @relation(fields: [workExperienceId], references: [id], onDelete: Cascade)

  @@map("work_experience_responsibilities")
}

// work-experience-detail: a specific initiative within a WorkExperience,
// carrying its own achievements and tech stack — distinct from the role's
// general responsibilities above.
model Project {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(300)
  description String?

  workExperienceId Int
  workExperience   WorkExperience @relation(fields: [workExperienceId], references: [id], onDelete: Cascade)

  achievements ProjectAchievement[]
  stack        ProjectStackItem[]

  @@map("projects")
}

model ProjectAchievement {
  id   Int    @id @default(autoincrement())
  text String

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_achievements")
}

// Deliberately independent from Skill — this is CV-mined, per-project
// technology usage, not the candidate's self-reported aggregate skill list.
// No shared taxonomy; kept as simple as Skill.name itself.
model ProjectStackItem {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_stack_items")
}

model Resume {
  id         Int      @id @default(autoincrement())
  filePath   String   @db.VarChar(500)
  fileType   String   @db.VarChar(50)
  uploadDate DateTime @default(now())

  // Personal info as reported in THIS specific CV — never written onto
  // Candidate.{firstName,lastName,email,phone,address}. Candidate.email is
  // the login credential and must stay independent of resume content: a
  // candidate may hold several resumes (e.g. tailored per application) that
  // report different or no contact info, and none of that should silently
  // change how they log in.
  extractedFirstName String? @db.VarChar(100)
  extractedLastName  String? @db.VarChar(100)
  extractedEmail     String? @db.VarChar(255)
  extractedPhone     String? @db.VarChar(15)
  extractedAddress   String? @db.VarChar(100)

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@map("resumes")
}

model Skill {
  id   Int       @id @default(autoincrement())
  name String    @db.VarChar(100)
  type SkillType
  // cv-extraction-schema-gaps: mirrors Language.proficiency — a stated
  // mastery level, free-text since CVs phrase it inconsistently.
  proficiency String? @db.VarChar(50)

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@map("skills")
}

model Language {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(50)
  proficiency String? @db.VarChar(50)

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@map("languages")
}

model Certification {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(150)
  issuer    String?   @db.VarChar(150)
  issueDate DateTime?

  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id])

  @@map("certifications")
}
