{
  "name": "@jobfinder/backend",
  "version": "0.1.0",
  "private": true,
  "description": "JobFinder Node.js API Gateway (backend/api) and job queue workers (backend/api/queue).",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only api/index.ts",
